# Maintainer: Joseph Martin <jmkl0987@gmail.com>
pkgname=i-hate-scans
pkgver=0.1.0
pkgrel=1
pkgdesc='i hate scans: convert document images, prompts, and PDFs to editable HTML5 & vector PDF locally'
arch=('x86_64' 'aarch64')
url='https://github.com/J0seph-Mart1n/ImgToPdf-Rust'
license=('MIT')
provides=('i-hate-scans')
conflicts=('img-to-pdf' 'docforge')
depends=('webkit2gtk-4.1' 'gtk3' 'xdotool' 'xdg-desktop-portal')
optdepends=(
  'ollama: local vision AI inference'
  'poppler: PDF-to-Editable-HTML BBox extraction and page rasterization'
  'chromium: headless vector PDF printing'
  'wl-clipboard: Wayland clipboard Ctrl+V image paste'
  'xclip: X11 clipboard Ctrl+V image paste'
)
# Rust/Cargo may be provided by either pacman (`rust`/`rustup`) or ~/.cargo/bin (`rustup-init`).
makedepends=()
options=('!debug' '!lto')
source=()
sha256sums=()

build() {
  export PATH="$HOME/.cargo/bin:$PATH"
  if ! command -v cargo >/dev/null 2>&1; then
    echo "Error: cargo not found. Install rust/rustup first." >&2
    return 1
  fi
  cd "$startdir/../desktop"
  if command -v dx >/dev/null 2>&1; then
    dx build --desktop --release
  else
    cargo build --release --locked
  fi
}

package() {
  local app_dir="$startdir/../desktop/target/dx/i-hate-scans/release/linux/app"

  if [ -f "$app_dir/i-hate-scans" ]; then
    install -Dm755 "$app_dir/i-hate-scans" "$pkgdir/usr/lib/$pkgname/i-hate-scans"
    if [ -d "$app_dir/assets" ]; then
      install -dm755 "$pkgdir/usr/lib/$pkgname/assets"
      cp -r "$app_dir/assets/." "$pkgdir/usr/lib/$pkgname/assets/"
    fi
  else
    install -Dm755 "$startdir/../desktop/target/release/i-hate-scans" "$pkgdir/usr/lib/$pkgname/i-hate-scans"
  fi

  install -dm755 "$pkgdir/usr/bin"
  ln -sf "/usr/lib/$pkgname/i-hate-scans" "$pkgdir/usr/bin/i-hate-scans"

  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/i-hate-scans.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/i-hate-scans.svg"
  install -Dm644 "$startdir/i-hate-scans.desktop" "$pkgdir/usr/share/applications/i-hate-scans.desktop"
}
