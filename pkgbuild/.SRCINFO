pkgbase = unscanme
	pkgdesc = UnScanMe: convert document images, prompts, and PDFs to editable HTML5 & vector PDF locally
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/J0seph-Mart1n/ImgToPdf-Rust
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = xdotool
	depends = xdg-desktop-portal
	optdepends = ollama: local vision AI inference
	optdepends = poppler: PDF-to-Editable-HTML BBox extraction and page rasterization
	optdepends = chromium: headless vector PDF printing
	optdepends = wl-clipboard: Wayland clipboard Ctrl+V image paste
	optdepends = xclip: X11 clipboard Ctrl+V image paste
	provides = unscanme
	conflicts = i-hate-scans
	conflicts = img-to-pdf
	conflicts = docforge
	options = !debug
	options = !lto

pkgname = unscanme
