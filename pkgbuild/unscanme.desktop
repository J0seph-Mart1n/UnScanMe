[Desktop Entry]
Type=Application
Name=UnScanMe
GenericName=Local Document Workbench
Comment=Convert document images, prompts, and PDFs into editable HTML5 and vector PDFs locally
Exec=unscanme %f
Icon=unscanme
Terminal=false
Categories=Office;Graphics;Utility;
MimeType=image/png;image/jpeg;image/webp;image/bmp;image/tiff;application/pdf;
StartupWMClass=unscanme
Keywords=pdf;ocr;html;ollama;scanner;converter;unscanme;
